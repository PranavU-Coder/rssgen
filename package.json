{
  "name": "rssgen",
  "version": "0.1.0",
  "description": "a super simple configurable whatsapp bot which acts as an rss feed generator tailored specifically for getting hackernews posts",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "baileys": "^7.0.0-rc.9",
    "dotenv": "^16.4.5",
    "link-preview-js": "^3.2.0",
    "pino": "^9.6.0",
    "pino-pretty": "^11.2.2",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/qrcode-terminal": "^0.12.2",
    "bun-types": "latest",
    "prettier": "^3.8.3",
    "typescript": "^5.6.3"
  }
}
